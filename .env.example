# Salin menjadi .env. Isi password sendiri; .env tidak masuk Git.
POSTGRES_DB=foodsave
POSTGRES_USER=foodsave
POSTGRES_PASSWORD=CHANGE_ME_WITH_RANDOM_PASSWORD
POSTGRES_PORT=5433
API_PORT=8000
# Untuk backend yang dijalankan langsung di Windows; URL dibuat otomatis.
DATABASE_HOST=localhost
DATABASE_PORT=5433
# DATABASE_URL opsional untuk koneksi eksternal; jika diisi, akan diprioritaskan.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
SESSION_DAYS=7

# Pengujian email hanya melalui Mailpit lokal, tidak diteruskan ke internet.
MAIL_BACKEND=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=foodsave@example.test
SMTP_TIMEOUT_SECONDS=10
