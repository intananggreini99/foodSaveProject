# Konfigurasi rilis lokal FoodSave (hanya localhost di laptop ini, tidak untuk deploy).
# Salin menjadi .env (Copy-Item .env.example .env) lalu ganti nilainya.
# Jangan commit file .env.
# Password hanya huruf dan angka (dipakai juga di URL koneksi MLflow).
POSTGRES_DB=foodsave
POSTGRES_USER=foodsave
POSTGRES_PASSWORD=gantiDenganPasswordKuat2026

# ---------- Port di komputer host --------------------------------------------
# Dibuat berbeda dari project lain di laptop yang sama:
#   SatisView : 3000, 5433, 8080, 9870      CampusFlow : 8081, 8088
# Cek bentrok sebelum start (tidak ada keluaran = aman):
#   Get-NetTCPConnection -State Listen -LocalPort 8010,5434,5010,9871,8026 -ErrorAction SilentlyContinue
FOODSAVE_API_PORT=8010
FOODSAVE_POSTGRES_PORT=5434
FOODSAVE_MLFLOW_PORT=5010
FOODSAVE_HDFS_UI_PORT=9871
FOODSAVE_MAILPIT_PORT=8026

# Alamat yang boleh mengirim POST/PUT ke API: Swagger UI FastAPI di /docs
# (port FOODSAVE_API_PORT). Sesuaikan bila port API diubah. Tambahkan alamat
# frontend di sini bila kelak frontend dipasang.
CORS_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
REGISTRATION_ENABLED=true
SESSION_DAYS=7
SMTP_FROM=foodsave@example.test

# Jumlah proses FastAPI (2 = ±2x lebih cepat saat banyak permintaan bersamaan)
FOODSAVE_API_WORKERS=2

# Ekspor data aktual ke HDFS (jam)
TRAINING_EXPORT_INTERVAL_HOURS=24

# Pipeline MLflow
TEST_FRACTION=0.2
CV_FOLDS=5
N_ESTIMATORS=200
# Inti CPU untuk pelatihan (laptop menjalankan beberapa project sekaligus)
N_JOBS=2

# --- Hanya untuk menjalankan backend/pipeline di luar Docker ---
# DATABASE_HOST=localhost
# DATABASE_PORT=5434
# FOODSAVE_STORAGE=local
# LOCAL_STORAGE_ROOT=./storage/hdfs
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
